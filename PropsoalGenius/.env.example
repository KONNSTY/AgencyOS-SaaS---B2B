# Copy to .env locally. Never commit actual values.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
AGENCY_OS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase web configuration (Firebase web API key is public, Admin key is private)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_MEASUREMENT_ID=

# For local Node execution set this to a credential outside the repository.
# Docker Compose overrides this path; FIREBASE_KEY_PATH is the host path there.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_KEY_PATH=./secrets/firebase-admin-key.json

# Server-side billing and integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AGENCY_OS_STRIPE_PRODUCT_ID=
AGENCY_OS_PRICE_EUR_MONTHLY=
AGENCY_OS_PRICE_USD_MONTHLY=
AGENCY_OS_PRICE_IDR_MONTHLY=
AGENCY_OS_PRICE_SGD_MONTHLY=
AGENCY_OS_PRICE_AUD_MONTHLY=
GEMINI_API_KEY=
GEMINI_MODEL=
BREVO_API_KEY=
EMAIL_PROVIDER=
EMAIL_SENDER=
EMAIL_SENDER_NAME=
EMAIL_SUPPORT=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
